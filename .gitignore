# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
release/
out/
dist/
dist-electron/
# `build/` is electron-builder's buildResources directory — an INPUT, not output.
# Ignore everything generated in it but keep the committed app icon, or CI builds
# an unbranded installer. (The negation needs `build/*`, not `build/`: git cannot
# re-include a file whose parent directory is itself excluded.)
build/*
!build/icon.png
*.tsbuildinfo

# Generated release artifacts
sbom.json

# Test / coverage
coverage/
playwright-report/
test-results/
.vitest/

# Local project data & secrets (never commit captured traffic or CA keys)
*.tacnocproj
projects/
*.pem
*.key
*.crt
ca-store/
!test/**/fixtures/**

# Logs
logs/
*.log
npm-debug.log*

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Env
.env
.env.*
!.env.example
